HF_HUB_VERBOSITY=error

# Groq Configuration (fast cloud LLM — for testing)
# LLM_PROVIDER=gemini
LLM_MODEL=qwen/qwen3.8-27b
STT_MODEL=whisper-large-v3-turbo
