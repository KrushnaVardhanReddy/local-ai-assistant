{
  "manifest_version": 3,
  "name": "BarnOwl AI",
  "version": "1.0.0",
  "description": "Your personal AI assistant, inside every Google Meet",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "sidebar.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.html",
        "sidebar.js",
        "sidebar.css"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ]
}